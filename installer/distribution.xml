<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Git Dashboard</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" rootVolumeOnly="true"/>

    <domains enable_localSystem="true"/>

    <choices-outline>
        <line choice="com.jypark.git-dashboard"/>
    </choices-outline>

    <choice id="com.jypark.git-dashboard"
            visible="false"
            title="Git Dashboard"
            description="Git Dashboard 앱을 /Applications 에 설치합니다.">
        <pkg-ref id="com.jypark.git-dashboard"/>
    </choice>

    <pkg-ref id="com.jypark.git-dashboard"
             version="0.1.0"
             onConclusion="none">GitDashboard.pkg</pkg-ref>
</installer-gui-script>
