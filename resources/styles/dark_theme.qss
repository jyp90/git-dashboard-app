/* ============================================================
   Git Dashboard — Design System Dark Theme
   phase-5-design-system 기반, 토큰 정의: app/ui/design_system.py
   ============================================================ */

/* ── 전역 폰트 ───────────────────────────────────────────── */
* {
    font-family: "Helvetica Neue", Arial;
    font-size: 13px;
    outline: none;
}

QMainWindow, QDialog {
    background-color: #060612;
}

QWidget {
    background-color: #0f0f1a;
    color: #e2e8f0;
}

/* ── 툴바 ───────────────────────────────────────────────── */
QToolBar {
    background-color: #060612;
    border-bottom: 1px solid #16162c;
    padding: 0 8px;
    spacing: 4px;
}

QToolBar QLabel {
    color: #94a3b8;
    font-size: 12px;
    background: transparent;
}

/* ── 콤보박스 ───────────────────────────────────────────── */
QComboBox {
    background-color: #1a1a2e;
    border: 1px solid #2d2d4a;
    border-radius: 5px;
    padding: 4px 10px;
    color: #e2e8f0;
    min-width: 160px;
    font-size: 12px;
}

QComboBox:hover {
    border-color: #4f4fa8;
    background-color: #20203a;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background-color: #14142a;
    border: 1px solid #3d3d6b;
    selection-background-color: #0c4a6e;
    selection-color: #7dd3fc;
    padding: 4px;
    font-size: 12px;
}

/* ── 탭 (기본값 — _EqualWidthTabBar inline QSS가 우선 적용됨) */
QTabWidget::pane {
    border: none;
    background-color: #0f0f1a;
}

/* ── 그룹박스 ───────────────────────────────────────────── */
QGroupBox {
    background-color: #14142a;
    border: 1px solid #2d2d4a;
    border-radius: 8px;
    margin-top: 8px;
    padding-top: 16px;
    font-size: 11px;
    font-weight: 600;
    color: #64748b;
    letter-spacing: 0.8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: -2px;
    padding: 0 6px;
    background-color: #14142a;
    color: #475569;
    font-size: 10px;
    letter-spacing: 1.2px;
}

/* ── 리스트 위젯 ─────────────────────────────────────────── */
QListWidget {
    background-color: #0f0f1a;
    border: none;
    color: #94a3b8;
    selection-background-color: #0c4a6e;
    selection-color: #7dd3fc;
    outline: none;
    font-size: 12px;
}

QListWidget::item {
    padding: 5px 8px;
    border-bottom: 1px solid #16162c;
    font-family: "Menlo", "Fira Code", monospace;
    font-size: 11px;
}

QListWidget::item:hover {
    background-color: #20203a;
    color: #e2e8f0;
}

QListWidget::item:selected {
    background-color: #0c4a6e;
    color: #7dd3fc;
}

/* ── 테이블 위젯 ─────────────────────────────────────────── */
QTableWidget {
    background-color: #14142a;
    border: none;
    gridline-color: #1e1e38;
    color: #cbd5e1;
    selection-background-color: #0c4a6e;
    selection-color: #e0f2fe;
    alternate-background-color: #1a1a30;
    font-size: 12px;
}

QTableWidget::item {
    padding: 6px 10px;
    border: none;
}

QTableWidget::item:hover {
    background-color: #20203a;
}

QHeaderView::section {
    background-color: #14142a;
    color: #64748b;
    padding: 6px 10px;
    border: none;
    border-bottom: 1px solid #2d2d4a;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
}

/* ── 스크롤바 ───────────────────────────────────────────── */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #3d3d6b;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #0ea5e9;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
    border: none;
    height: 0;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #3d3d6b;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #0ea5e9;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
    border: none;
    width: 0;
}

/* ── 스플리터 ───────────────────────────────────────────── */
QSplitter::handle {
    background-color: #1e1e38;
}

QSplitter::handle:hover {
    background-color: #0ea5e9;
}

/* ── 상태바 ─────────────────────────────────────────────── */
QStatusBar {
    background-color: #060612;
    border-top: 1px solid #16162c;
    color: #64748b;
    font-size: 11px;
    padding: 2px 8px;
}

QStatusBar QLabel {
    color: #64748b;
    font-size: 11px;
    padding: 2px 4px;
    background: transparent;
}

/* ── 툴팁 ───────────────────────────────────────────────── */
QToolTip {
    background-color: #14142a;
    color: #e2e8f0;
    border: 1px solid #3d3d6b;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* ── 다이얼로그 버튼박스 ─────────────────────────────────── */
QDialogButtonBox QPushButton {
    background-color: #1a1a2e;
    color: #94a3b8;
    border: 1px solid #2d2d4a;
    border-radius: 5px;
    padding: 5px 16px;
    font-size: 12px;
    min-width: 72px;
}

QDialogButtonBox QPushButton:hover {
    background-color: #20203a;
    color: #7dd3fc;
    border-color: #3d3d6b;
}

QDialogButtonBox QPushButton:default {
    background-color: #082f49;
    color: #7dd3fc;
    border-color: #0ea5e9;
}

QDialogButtonBox QPushButton:default:hover {
    background-color: #0c4a6e;
}

/* ── 텍스트 에디트 / 라인 에디트 ─────────────────────────── */
QLineEdit {
    background-color: #1a1a2e;
    color: #e2e8f0;
    border: 1px solid #2d2d4a;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
    selection-background-color: #0c4a6e;
}

QLineEdit:focus {
    border-color: #0ea5e9;
}

QTextEdit {
    background-color: #1a1a2e;
    color: #e2e8f0;
    border: 1px solid #2d2d4a;
    border-radius: 4px;
    font-size: 12px;
    selection-background-color: #0c4a6e;
}

QTextEdit:focus {
    border-color: #0ea5e9;
}

/* ── 메시지 박스 ─────────────────────────────────────────── */
QMessageBox {
    background-color: #14142a;
}

QMessageBox QLabel {
    color: #e2e8f0;
    font-size: 13px;
    background: transparent;
}
